# conexion a PostgreSQL (solo si se corre el backend sin Docker; Docker usa los valores de docker-compose.yml)
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lab1bd_veterinaria
DB_USER=postgres
DB_PASSWORD=change_me
FRONTEND_ORIGIN=http://localhost:5173

# clave con que se firman los tokens: cambiala por un texto largo y secreto
JWT_SECRET=cambia_esta_clave_por_una_larga_y_secreta

# cuenta de administrador inicial: se crea UNA sola vez, la primera vez que se inicia el sistema; despues cambiar estos valores no la modifica
ADMIN_NOMBRE=Administrador General
ADMIN_CORREO=admin@redvet.cl
ADMIN_PASSWORD=admin123
